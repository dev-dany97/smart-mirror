# Copy to ~/MagicMirror/config/config.env and fill in your own values.
# MagicMirror² replaces ${VARIABLE} in config/config.js.template with these
# values and writes config/config.js on startup.
# Never commit the real config.env.

# MMM-CoinMarketCap (https://coinmarketcap.com/api/)
COINMARKETCAP_API_KEY=your-coinmarketcap-api-key

# MMM-AVStock: purchase prices in the same order as "symbols", comma separated
AVSTOCK_PURCHASE_PRICES=0, 0, 0, 0, 0, 0

# MMM-Remote-Control: any long random string
REMOTE_CONTROL_API_KEY=your-remote-control-api-key

# netatmo (https://dev.netatmo.com/apps)
NETATMO_CLIENT_ID=your-netatmo-client-id
NETATMO_CLIENT_SECRET=your-netatmo-client-secret
NETATMO_REFRESH_TOKEN=your-netatmo-refresh-token

# MMM-Tado
TADO_USERNAME=you@example.com
TADO_PASSWORD=your-tado-password

# Optional: published iCloud calendar (only used in the commented-out example)
ICLOUD_CALENDAR_URL=webcal://pXX-caldav.icloud.com/published/2/your-calendar-token
